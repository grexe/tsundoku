name			toji
version			@VERSION@
architecture	@ARCH@
summary			"A universal document reader for Haiku, extended for SEN"
description		"Toji is a document reader for Haiku, based on BePDF and rendering with
MuPDF. It reads PDF files, EPUB books, comics (CBZ, CBR, CB7, CBT, BBF), DjVu
documents and more, lets you select, search and mark text, add notes and
shapes and keep bookmarks, and writes what a document says about itself to
the attributes of the file. Annotations are Web Annotations that SEN (Semantic
Extensions Native) and other programs can read and control by scripting."
packager		"Gregor B. Rosenauer <semantic.extensions@gmail.com>"
vendor			"SEN Labs e.U."
copyrights		{
	"2026 Gregor B. Rosenauer"
	"2013-2017 waddlesplash"
	"2000-2011 Michael Pfeiffer"
	"1998-2000 Hubert Figuiere"
	"1997 Benoit Triquet"
	"Artifex Software, Inc. (MuPDF)"
}
licenses		{
	"GNU AGPL v3"
	"MIT"
}
urls			{
	"https://github.com/sen-laboratories/toji"
}
replaces		{
	tsundoku
}
provides		{
	toji = @VERSION@
	app:Toji = @VERSION@
}
requires		{
	haiku
	lib:libfreetype
	lib:libmupdf1.28 >= 1.28
	lib:libarchive
	lib:libdjvulibre
	lib:libxml2
	lib:libzip
}
