name			tsundoku
version			@VERSION@
architecture	@ARCH@
summary			"A universal document reader for Haiku, extended for SEN"
description		"Tsundoku is a document reader for Haiku, based on BePDF and
rendering with MuPDF. It reads PDF files and adds support for the semantic
relations of SEN (Semantic Extensions Native), e.g. jumping to a page handed
over by a relation. Settings and per-file bookmarks stay compatible with BePDF."
packager		"Gregor B. Rosenauer <semantic.extensions@gmail.com>"
vendor			"SEN Labs e.U."
copyrights		{
	"2026 Gregor B. Rosenauer"
	"2013-2017 waddlesplash"
	"2000-2011 Michael Pfeiffer"
	"1998-2000 Hubert Figuiere"
	"1997 Benoit Triquet"
	"Artifex Software, Inc. (MuPDF)"
}
licenses		{
	"GNU AGPL v3"
	"MIT"
}
urls			{
	"https://github.com/sen-laboratories/tsundoku"
}
provides		{
	tsundoku = @VERSION@
	app:Tsundoku = @VERSION@
}
requires		{
	haiku
	lib:libfreetype
	lib:libmupdf1.28 >= 1.28
	lib:libarchive
	lib:libdjvulibre
	lib:libxml2
	lib:libzip
}
